{
  "name": "dataviz",
  "version": "1.1.0",
  "description": "David's sandbox for dataviz",
  "repository": "https://github.com/david-ma/dataviz.git",
  "author": "David Ma <github@david-ma.net>",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun scripts/build-client.ts --minify",
    "build:dev": "bun scripts/build-client.ts",
    "develop:client": "bun scripts/build-client.ts --watch",
    "preview": "bun run build:dev && NODE_ENV=production thalia",
    "scrape": "node config/scripts/scrape_awesome.js",
    "deploy:quick": "sh config/scripts/quick_update.sh",
    "wiki": "node scripts/wiki.js",
    "blog": "bash scripts/newBlogpost.sh",
    "start": "thalia",
    "dev": "thalia-develop",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json",
    "test": "bun test test/ tests/",
    "statues:csv": "bun scripts/build-statues-csv.ts"
  },
  "dependencies": {
    "@dimforge/rapier2d-compat": "^0.14.0",
    "@dimforge/rapier3d-compat": "^0.14.0",
    "@observablehq/stdlib": "^5.8.8",
    "@types/jquery": "^3.5.29",
    "amdefine": "^1.0.1",
    "axios": "^1.6.8",
    "d3": "^7.9.0",
    "d3-cloud": "^1.2.7",
    "d3-sankey": "^0.12.3",
    "datatables.net": "^2.0.3",
    "formidable": "^3.5.1",
    "http-proxy": "^1.18.1",
    "jquery": "^3.7.1",
    "lodash": "^4.17.21",
    "mime": "^2.6.0",
    "mustache": "^4.2.0",
    "showdown": "^2.1.0",
    "socket.io": "^4.7.5",
    "thalia": "github:david-ma/Thalia",
    "three": "^0.172.0"
  },
  "resolutions": {
    "css-what": "5.0.1"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/d3-cloud": "^1.2.9",
    "@types/d3-sankey": "^0.12.4",
    "@types/node": "^18.19.31",
    "@types/three": "^0.172.0",
    "@webgpu/types": "^0.1.52",
    "csv": "^6.3.8",
    "sass": "^1.75.0",
    "tabletojson": "^2.1.1",
    "ts-node": "^10.9.2",
    "x-ray": "^2.3.4"
  }
}
