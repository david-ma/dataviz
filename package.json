{
  "name": "dataviz",
  "version": "1.1.0",
  "description": "David's sandbox for dataviz",
  "repository": "https://github.com/david-ma/dataviz.git",
  "author": "David Ma <github@david-ma.net>",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun scripts/build-client.ts --minify",
    "build:dev": "bun scripts/build-client.ts",
    "develop:client": "bun scripts/build-client.ts --watch",
    "preview": "bun run build:dev && NODE_ENV=production thalia",
    "scrape": "node config/scripts/scrape_awesome.js",
    "deploy": "ssh yoshi 'ANSIBLE_PATH=/usr/bin /usr/local/dev/scripts/homelab_cluster/scripts/run-playbook.sh deploy-dataviz.yml aang'",
    "wiki": "node scripts/wiki.js",
    "blog": "bash scripts/newBlogpost.sh",
    "start": "thalia",
    "dev": "thalia-develop",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test test/ tests/",
    "statues:csv": "bun scripts/build-statues-csv.ts",
    "earthquake:avatars": "bun scripts/cache-earthquake-avatars.ts",
    "preview:png": "bun scripts/capture-preview.ts"
  },
  "dependencies": {
    "@dimforge/rapier2d-compat": "^0.20.0",
    "@dimforge/rapier3d-compat": "^0.20.0",
    "@observablehq/stdlib": "^5.8.8",
    "axios": "^1.20.0",
    "d3": "^7.9.0",
    "d3-sankey": "^0.12.3",
    "datatables.net": "^2.3.8",
    "jquery": "^3.7.1",
    "lodash": "^4.18.1",
    "showdown": "^2.1.0",
    "thalia": "github:david-ma/Thalia",
    "three": "^0.185.1"
  },
  "resolutions": {
    "css-what": "5.0.1",
    "jquery": "3.7.1"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/d3-sankey": "^0.12.5",
    "@types/jquery": "^3.5.34",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.19.21",
    "@types/three": "^0.185.4",
    "csv": "^6.6.3",
    "jsdom": "^26.1.0",
    "sass": "^1.103.1",
    "typescript": "7.0.2",
    "x-ray": "^2.3.4"
  }
}
