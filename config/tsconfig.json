{
  "compilerOptions": {
    "rootDir": "../",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2020",
    "lib": ["ES2020"],
    "strict": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "paths": {
      "@dataviz/chart": ["../src/js/chart"],
      "@dataviz/datatable": ["../src/js/datatable"]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    "src",
    "public"
  ]
}