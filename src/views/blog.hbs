<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta http-equiv="x-ua-compatible" content="ie=edge" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />

  {{#blogpost}}
  <title>{{title}}</title>

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:creator"    content="@frostickle" />
  <meta name="twitter:title"      content="{{title}}" />
  <meta name="twitter:description" content="{{summary}}" />
  <meta name="twitter:image"      content="{{#image_url}}{{{image_url}}}{{/image_url}}{{^image_url}}https://dataviz.david-ma.net/{{{image}}}{{/image_url}}" />

  <meta property="og:url"         content="https://dataviz.david-ma.net/blog/{{shortname}}/" />
  <meta property="og:type"        content="article" />
  <meta property="og:title"       content="{{title}}" />
  <meta property="og:description" content="{{summary}}" />
  <meta property="og:image"       content="{{#image_url}}{{{image_url}}}{{/image_url}}{{^image_url}}https://dataviz.david-ma.net/{{{image}}}{{/image_url}}" />
  <meta property="og:image:width"  content="1212px" />
  <meta property="og:image:height" content="830px" />
  <meta property="fb:app_id"   content="793893040633491" />

  <meta name="author"             content="David Ma" />
  <meta property="article:author" content="http://www.facebook.com/frostickle" />
  {{/blogpost}}

{{> assets}}
{{> styles }}
</head>
<body>
{{> header}}

  <div id="dataviz_blog" class="container-fluid page">
    <div class="row equal">
{{> nav}}

      <div id="content_reactive_wrapper" class="col-xs-12 col-sm-9 col-md-10" style="margin: 0 auto;">
      <div class="visible-xs-block" style="height:50px;"></div>
      {{#blogpost}}<p style="margin-bottom:0"><a href="/">&larr; All visualisations</a></p>{{/blogpost}}
{{> content }}
      </div>
    </div>
  </div>

{{> footer}}


{{> scripts }}
</body>
</html>
